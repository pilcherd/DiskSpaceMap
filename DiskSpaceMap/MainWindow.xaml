<Window x:Class="DiskSpaceMap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskSpaceMap" Title="DiskSpaceMap" Icon="Assets/AppIcon.ico" Width="1380" Height="900" MinWidth="1080" MinHeight="720" Background="{StaticResource BackgroundBrush}" Foreground="#E9EFF7" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Grid Margin="26,20,26,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="DRIVE" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/>
          <ComboBox x:Name="DrivePicker" Grid.Row="1" SelectionChanged="Drive_Changed" DisplayMemberPath="Label" AutomationProperties.Name="Select drive" ToolTip="Choose a drive to scan. C:\ is selected on startup." MinHeight="36" Margin="0,0,12,0"/>
          <Button x:Name="ScanButton" Grid.Row="1" Grid.Column="1" Content="Rescan drive" Background="{StaticResource AccentBrush}" Foreground="#10251F" FontWeight="SemiBold" MinHeight="36" Click="Scan_Click"/>
        </Grid>
        <UniformGrid Grid.Column="2" Columns="4" VerticalAlignment="Center">
          <Border BorderBrush="#344358" BorderThickness="1,0,0,0" Padding="14,4"><StackPanel><TextBlock Text="MAPPED FILE SIZE" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="BytesStat" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="#72E2BF" Margin="0,3,0,0"/></StackPanel></Border>
          <Border BorderBrush="#344358" BorderThickness="1,0,0,0" Padding="14,4"><StackPanel><TextBlock Text="FILES FOUND" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="FilesStat" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border BorderBrush="#344358" BorderThickness="1,0,0,0" Padding="14,4"><StackPanel><TextBlock Text="FOLDERS FOUND" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="FoldersStat" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border BorderBrush="#344358" BorderThickness="1,0,0,0" Padding="14,4"><StackPanel><TextBlock x:Name="TimeLabel" Text="SCAN TIME" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TimeStat" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="RateStat" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
        </UniformGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="UpButton" Content="↑  Up" Click="Up_Click" IsEnabled="False" Padding="12,7" Margin="0,0,7,0" ToolTip="Go up (Alt+Up or Backspace)"/>
      <Button x:Name="RootButton" Grid.Column="1" Content="⌂  Root" Click="Root_Click" IsEnabled="False" Padding="12,7" Margin="0,0,7,0"/>
      <Button x:Name="RefreshButton" Grid.Column="2" Content="↻  Refresh" Click="Refresh_Click" IsEnabled="False" Padding="12,7" Margin="0,0,12,0" ToolTip="Rescan this folder and all subfolders (F5)" AutomationProperties.Name="Refresh current folder and subfolders"/>
      <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><StackPanel x:Name="Breadcrumbs" Orientation="Horizontal"><TextBlock Text="Select a drive to begin" Foreground="#94A4B9"/></StackPanel></ScrollViewer>
      <Button x:Name="OpenCurrentButton" Grid.Column="4" Content="Open folder  ↗" Click="OpenCurrent_Click" IsEnabled="False" Padding="12,7" Margin="10,0,0,0"/>
    </Grid>

    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="370" MinWidth="280"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12"><TextBlock x:Name="MapTitle" Text="Drive map" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MapSubtitle" Text="Select a drive to begin." Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
          <local:TreemapView x:Name="Map" Grid.Row="1" SelectionChanged="Map_SelectionChanged" FolderInvoked="Map_FolderInvoked" LocationInvoked="Map_LocationInvoked" AutomationProperties.Name="Disk usage treemap"/>
          <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="A clearer view of your drive." FontSize="23" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Select a drive above to see what takes up space." Style="{StaticResource Muted}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/></StackPanel>
          <TextBlock Grid.Row="2" Text="Area = file size  ·  Click a folder to show its contents  ·  Right-click to open in Explorer" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="0,14,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="14,0,14,12"><TextBlock Text="Inside this folder" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ItemCount" HorizontalAlignment="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
          <TextBox x:Name="FilterBox" Grid.Row="1" Margin="14,0,14,12" AutomationProperties.Name="Filter current folder" ToolTip="Filter the names immediately inside this folder" TextChanged="Filter_Changed"/>
          <DataGrid x:Name="Entries" Grid.Row="2" SelectionChanged="Entries_SelectionChanged" MouseDoubleClick="Entries_DoubleClick" PreviewMouseRightButtonDown="Entries_RightClick" ContextMenuOpening="Entries_ContextMenuOpening" KeyDown="Entries_KeyDown" Sorting="Entries_Sorting" AutomationProperties.Name="Folders and files">
            <DataGrid.ContextMenu><ContextMenu><MenuItem x:Name="OpenEntryMenu" Header="Open in Explorer" Click="OpenEntry_Click"/><MenuItem x:Name="DrillEntryMenu" Header="Drill into folder" Click="DrillEntry_Click"/></ContextMenu></DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontFamily="Segoe MDL2 Assets"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Width="100" SortMemberPath="Size"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"/><TextBlock Text="{Binding ShareText}" Foreground="#94A4B9" FontSize="10" HorizontalAlignment="Right"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="3" Text="Enter: drill in   ·   Ctrl+Enter: open location" Style="{StaticResource Muted}" FontSize="10" Margin="14,10,14,12"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="ScanProgressBar" Height="3" IsIndeterminate="True" Foreground="#72E2BF" Background="#263345" Visibility="Collapsed" Margin="0,0,0,8"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready to scan" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><Button x:Name="WarningsButton" Grid.Column="1" Content="Scan details" Click="Warnings_Click" Padding="8,2" FontSize="11" Visibility="Collapsed"/></Grid></Grid>
  </Grid>
</Window>
