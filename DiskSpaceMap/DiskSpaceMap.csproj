<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AssemblyName>DiskSpaceMap</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Fast Windows disk-space visualizer with interactive treemaps and folder drill-down.</Description>
    <Authors>David Pilcher</Authors>
    <RepositoryUrl>https://github.com/pilcherd/DiskSpaceMap</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../LICENSE" LogicalName="DiskSpaceMap.LICENSE" />
    <Resource Include="Assets/AppIcon.ico" />
    <ProjectReference Include="../DiskSpaceMap.Core/DiskSpaceMap.Core.csproj" />
    <InternalsVisibleTo Include="DiskSpaceMap.RenderChecks" />
  </ItemGroup>
</Project>
